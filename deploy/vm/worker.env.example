# Worker config for one VM. Fill in a copy, upload it, and pass it to setup.sh, which moves it to
# /opt/arkivate/.env (owner arkivate, chmod 600). Never commit a filled-in copy.
# Blank values mean "use the default".
# One identity per VM: worker-1 and worker-2 each get their own name and key.

# --- Required ---------------------------------------------------------------
# The worker's own wallet: 64 hex chars, 0x optional. Fund it at https://hub.arkiv.network/faucet.
WORKER_PRIVATE_KEY=
# Name in the on-chain worker entity and the job-store file name (e.g. worker-1).
WORKER_NAME=
# Public HTTPS URL of this VM, published in the worker entity for sealed hand-offs
# (e.g. https://34-123-45-67.sslip.io).
PUBLIC_ENDPOINT=

# --- Recommended ------------------------------------------------------------
# Arkiv access key, sent as X-API-KEY. Without it, reads share ~100 queries/hour/IP.
ARKIV_ACCESS_KEY=
# Exact browser origins allowed on /health and POST /sealed, comma-separated
# (e.g. https://arkivate.vercel.app,http://localhost:3000). Default: http://localhost:3000.
CORS_ORIGINS=
# Gas guard: comma-separated 0x addresses whose public triggers AND sealed hand-offs this worker
# accepts. Empty = anyone.
TRIGGER_CREATORS=

# --- Optional ---------------------------------------------------------------
# Receipts this worker writes per trigger per hour. Default: 12.
MAX_RECEIPTS_PER_TRIGGER_PER_HOUR=
# Read budget (each arkiv_query costs the access key 100 units; arkiv/friction.md F20).
# Expiry sweep, silence/count pollers, full refresh of triggers + workers, WS batch window.
# Defaults: 30, 30, 1800, 5 (seconds).
SWEEP_SECONDS=
POLL_SECONDS=
REFRESH_SECONDS=
FLUSH_SECONDS=
# Bot used to deliver sealed Telegram alerts.
TELEGRAM_BOT_TOKEN=
# RPC endpoints. Default: Tiramisu.
ARKIV_RPC_HTTP=
ARKIV_RPC_WS=
# Listen port. Default: 8787 (the Caddyfile proxies to 127.0.0.1:8787; change both together).
WORKER_PORT=
# Bind address. Default: 127.0.0.1 under systemd (NODE_ENV=production). Keep it behind Caddy.
HOST=
# Reported as /health "version" only if `git rev-parse` fails.
GIT_SHA=
# Job store directory (absolute or relative). Leave empty on the VM: the systemd unit sets
# DATA_DIR=/var/lib/arkivate, which overrides this file.
DATA_DIR=
# DEMO SWITCH ONLY: accept sealed jobs but never fire them. Default: false. Never on a trusted worker.
SKIP_SEALED=
