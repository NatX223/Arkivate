# Arkivate env, grouped by what reads it. Locally, one root .env serves all three; deployed, each
# deployable gets only its own group. Blank values mean "use the default".

# ============================================================================
# Worker (backend/worker): pnpm worker, or deploy/vm (see deploy/vm/worker.env.example)
# One identity per deployment: worker-1 and worker-2 each have their own name and key.
# ============================================================================
WORKER_NAME=
# 64 hex chars, 0x optional
WORKER_PRIVATE_KEY=
WORKER_PORT=8787
# Bind address; default 127.0.0.1 when NODE_ENV=production, else 0.0.0.0
HOST=
# Public URL published in the worker entity, for sealed hand-offs (locally http://localhost:8787)
PUBLIC_ENDPOINT=
# Job store directory, absolute or relative; default backend/worker/data
DATA_DIR=
# Exact browser origins allowed on /health and POST /sealed (comma-separated; no *)
CORS_ORIGINS=http://localhost:3000
# Gas guard (optional): comma-separated creators whose public triggers and sealed hand-offs this
# worker accepts; empty = all
TRIGGER_CREATORS=
MAX_RECEIPTS_PER_TRIGGER_PER_HOUR=12
TELEGRAM_BOT_TOKEN=
# Reported by /health as "version" when git is unavailable
GIT_SHA=
# DEMO SWITCH ONLY: accept sealed jobs but never fire them (staged censorship demo)
SKIP_SEALED=false

# ============================================================================
# Frontend (frontend/, Vercel). Server-side only, read by the /api/rpc read proxy. The frontend
# reads no NEXT_PUBLIC_* variables. Locally, next.config.ts copies just these two from this file.
# ============================================================================
# ARKIV_ACCESS_KEY  (shared, below)
# ARKIV_RPC_HTTP    (shared, below)

# ============================================================================
# CLI and scripts (backend/cli, backend/scripts), local only
# ============================================================================
OWNER_PRIVATE_KEY=
SEALED_OWNER_PRIVATE_KEY=

# ============================================================================
# Shared by worker, frontend and CLI
# ============================================================================
ARKIV_RPC_HTTP=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# worker and CLI only
ARKIV_RPC_WS=wss://rpc.tiramisu.db-chain.testnet.arkiv.network
# Never in browser code; on Vercel set it as a plain (server) env var, not NEXT_PUBLIC_
ARKIV_ACCESS_KEY=
